{
  "name": "reading-log",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run clean:dev",
    "dev": "next dev --turbopack -H 0.0.0.0",
    "clean:dev": "powershell -NoProfile -Command \"Remove-Item -Recurse -Force .next-dev -ErrorAction SilentlyContinue; exit 0\"",
    "clean": "powershell -NoProfile -Command \"Remove-Item -Recurse -Force .next,.next-dev,.next-static -ErrorAction SilentlyContinue; exit 0\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.45.4",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.12.0",
    "eslint-config-next": "^15.0.0",
    "supabase": "^2.109.1",
    "typescript": "^5.6.2"
  }
}
